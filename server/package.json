{
  "name": "transcript-system-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API server for the Computerized Transcript Digitization and Result Retrieval System",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "import:oau-courses": "node src/seed/importOauCourses.js",
    "import:oau-resolved": "node src/seed/importOauResolvedRegister.js",
    "import:oau-ready43": "node src/seed/importOauReady43.js",
    "sync:programme-course-aliases": "node src/seed/syncProgrammeCourseAliases.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "papaparse": "^5.5.4",
    "puppeteer": "^25.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
